# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Langfuse observability (optional but recommended for the demo walkthrough)
# Get these from https://cloud.langfuse.com → Settings → API Keys
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# App settings
ENVIRONMENT=development
DATABASE_URL=sqlite:///./sahayak.db
CHROMA_PERSIST_DIR=./chroma_db
GRAPH_CHECKPOINT_DB=./checkpoints.db

# Model routing — this is where cost control happens
# Cheap fast model for simple classification tasks (Node 1)
INTENT_MODEL=claude-haiku-4-5-20251001
# Reasoning model for RAG + complex judgment (Node 2 & 3)
REASONING_MODEL=claude-sonnet-4-6

# CORS — update this when deploying the frontend
FRONTEND_URL=http://localhost:5173
